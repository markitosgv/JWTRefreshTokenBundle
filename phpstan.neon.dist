includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon

parameters:
    level: 10
    paths:
        - src
        - tests
    bootstrapFiles:
        - tests/bootstrap.php
    ignoreErrors:
        # phpstan-doctrine only models the ORM metadata, so it does not know that the ODM assigns
        # the identifier of a document. The ORM fixtures are handled by the extension itself.
        -
            identifier: property.unusedType
            path: tests/Functional/Fixtures/Document/User.php
        # quoteSingleIdentifier() and addPrimaryKeyConstraint() replace methods deprecated in
        # doctrine/dbal 4 and do not exist in 3, which doctrine/orm 2.20 still brings in. They only
        # look redundant because the analysis runs against the newest version the lock resolves to.
        -
            identifier: function.alreadyNarrowedType
            path: src/Doctrine/DBAL/RefreshTokenManager.php
        -
            identifier: function.alreadyNarrowedType
            path: src/Doctrine/DBAL/TableSchemaManager.php
